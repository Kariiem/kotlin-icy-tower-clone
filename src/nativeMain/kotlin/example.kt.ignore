@file:OptIn(ExperimentalForeignApi::class)
import kotlinx.cinterop.ExperimentalForeignApi
import kotlin.math.cos
import kotlin.math.sin

import raylib.*
import raylib.wrapper.*
import geom.*
import utils.*

fun bell() {
    setTraceLogLevel(LOG_ALL)
    setConfigFlags(FLAG_WINDOW_UNDECORATED  or
                   FLAG_WINDOW_TOPMOST      or
                   FLAG_WINDOW_ALWAYS_RUN)
    initWindow(StaticConfig.WIDTH, StaticConfig.HEIGHT, StaticConfig.WIN_TITLE)
    initAudioDevice()

    val bell   = loadSound(StaticConfig.BELL_FILEPATH)
    val origin = Pos(StaticConfig.WIDTH/2, StaticConfig.HEIGHT/2)
    val radius = 100.0f
    val slack  = 200.0f
    val center = origin + Pos(radius.toInt() + slack.toInt(), 0)
    var time   = 0.0
    var dir    = -1
    var pause  = false
    var count  = 3.0f

    loop@ while(!windowShouldClose()) {
        val dt = getFrameTime()
        when (getKeyPressed()) {
            KEY_Q -> break@loop
            KEY_R -> {
                time = 0.0
                dir  = -1
                pause = false
                stopSound(bell)
            }
            KEY_SPACE, KEY_K -> {
                pause = !pause
                if (pause) {
                    pauseSound(bell)
                } else {
                    resumeSound(bell)
                }
            }
        }
        beginDrawing()
        clearBackground(black);
        drawCircle(origin.x, origin.y, slack, green)
        drawCircle(center.x, center.y, radius, red)
        endDrawing()

        if (!pause) {
            time += dt
            val angle = 2.0 * PI * time / count
            center.x = origin.x + ((radius + slack) * cos(dir * angle)).toInt()
            center.y = origin.y + ((radius + slack) * sin(dir * angle)).toInt()

            if (angle >= 2.0 * PI) {
                playSound(bell)
                dir = -dir
                time = 0.0
            }
        }
    }

    closeAudioDevice()
    closeWindow()
}
